component grammar ArcCompute extends ArcBasis,
        de.monticore.statements.MCStatementsBasis {

   /**
    * ASTArcInit holds a initialization behavior statement.
    */
   ArcInit implements ArcElement = key("init") MCStatement;

  /**
   * ASTArcCompute holds a compute behavior statement.
   */
  ArcCompute implements ArcBehaviorElement = Stereotype? key("compute") MCStatement;

}
