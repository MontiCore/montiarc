package factory;

import java.util.Date;
import java.util.List;

classdiagram Factory {

  public class Inquiry {
    String inquiryId;
    Date requiredDueDate;
  }

  public class OrderQuotation {
    String quotationId;
    String inquiryId;
  }

  public class OrderConfirmation {
    String quotationId;
    boolean confirmed;
  }

  public class SalesOrder {
    String salesOrderId;
  }

  public class OrderItem {
    int itemNumber;
    public int quantity;
    String partId;
  }

  association [1] SalesOrder <-> (items) OrderItem [1..*];

  public class ProductionOrder {
    String productionOrderId;
    OrderItem orderItem;
    BillOfMaterial bom;
  }

  public class Operation {}

  public class BillOfMaterial {}

  association [1] ProductionOrder <-> (productionSteps) Operation [1..*];

  public class PurchaseOrder {
    String purchaseOrderId;
    double amount;
    String materialId;
  }

  public class Material {
    String materialId;
    double amount;
  }

  public class MaterialRequest {
    String materialId;
    double amount;
  }

  public class Inventory {}

  public class Shipping {}

  public class ShippingConfirmation {}

  public class ProductConfig {}

  public class Product {}

  public class WorkPiece {}

  // Gear production
  public class GearBlank extends WorkPiece {}
  public class Gear extends WorkPiece {}

}
