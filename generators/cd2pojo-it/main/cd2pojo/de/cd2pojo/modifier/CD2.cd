package de.cd2pojo.modifier;

import de.cd2pojo.modifier.CD1.IPackage;
import de.cd2pojo.modifier.CD1.CPackage;
import de.cd2pojo.modifier.CD1.EPackage;

/**
 * Interface I, class C, and enum E are visible even though they have default
 * (package) visibility as they are defined in the same package although in
 * another classdiagram.
 */
classdiagram CD2 {

  interface I1 extends IPackage;
  class C1 implements IPackage;
  class C2 extends CPackage;
  enum E1 implements IPackage;

}
