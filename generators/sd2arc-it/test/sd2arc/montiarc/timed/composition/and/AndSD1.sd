package montiarc.timed.composition.and;

import montiarc.types.OnOff;

<<montiarc="main/montiarc/montiarc/timed/composition/And.arc">>
sequencediagram AndSD1 {
  visible notA;
  notB;
  nor:Nor;

  // And forwards a to notA.a and notA.b, and b to notB.a and notB.b. Embedded triggers are not yet
  // forwarded to all ports connected to the same interface port (see TODO in AssertOrderSubcomponent.ftl)
  -> notA.a : trigger true ;
  -> notA.b : trigger true ;
  -> notB.a : trigger true ;
  -> notB.b : trigger true ;
  notA.q -> nor.a : false ;
  nor.q -> : ... ;

  assert (notA.a && notB.b) == nor.q;
}
