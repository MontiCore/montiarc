package montiarc.sync.automata.inverter;

import montiarc.types.OnOff;
import montiarc.sync.automata.Inverter;

complete sequencediagram CompleteSD {
  inv1:Inverter;
  inv2:Inverter;

  let OnOff input = OnOff.ON;

  Tick {
    -> inv1.i : trigger input;
    inv1.o -> inv2.i : OnOff.OFF;
    inv2.o -> : OnOff.ON;
  }

  let OnOff mid = inv1.o;
  assert input == OnOff.ON;
  assert inv1.o == OnOff.OFF;
  assert mid == inv1.o;

  Tick {
    inv1.o -> inv2.i : OnOff.OFF;
    inv2.o -> : OnOff.ON;
  }
}
