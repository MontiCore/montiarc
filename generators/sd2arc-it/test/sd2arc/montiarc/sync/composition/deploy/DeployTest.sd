import montiarc.types.OnOff;

<<montiarc="main/montiarc/montiarc/sync/composition/Deploy.arc">>
sequencediagram DeployTest {
  parallel;

  Tick {
    parallel.o1 -> : OnOff.OFF;
    parallel.o2 -> : OnOff.OFF;
  }

  Tick {
    parallel.o1 -> : OnOff.OFF;
    parallel.o2 -> : OnOff.OFF;
  }

  Tick {
    parallel.o1 -> : OnOff.OFF;
    parallel.o2 -> : OnOff.OFF;
  }
}
