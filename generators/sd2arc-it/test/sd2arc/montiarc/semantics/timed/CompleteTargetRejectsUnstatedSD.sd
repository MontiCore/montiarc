package montiarc.semantics.timed;

import montiarc.types.OnOff;
import montiarc.timed.automata.Inverter;

// match stereotypes per object: inv1 is free, but inv2 is complete, so the omitted
// interaction inv1.o -> inv2.i : ON is forbidden as it involves inv2
<<ticks=20, exception=java.lang.AssertionError.class>>
sequencediagram CompleteTargetRejectsUnstatedSD {
  inv1:Inverter;
  complete inv2:Inverter;

  -> inv1.i : trigger OnOff.ON;
  -> inv1.i : trigger OnOff.OFF;
  -> inv1.i : trigger OnOff.ON;
  inv1.o -> inv2.i : OnOff.OFF;
  inv1.o -> inv2.i : OnOff.OFF;
}
