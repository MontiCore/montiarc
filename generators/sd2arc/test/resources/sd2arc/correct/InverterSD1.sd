package sd2arc.correct;

import montiarc.types.OnOff;
import montiarc.timed.Inverter;

sequencediagram InverterSD1 {
  inv:Inverter;

  let OnOff m = OnOff.ON;

  -> inv.i : trigger OnOff.ON;
  inv.o -> : OnOff.OFF;
  -> inv.i : trigger inv.o;
  inv.o -> : ...;
  let OnOff m2 = inv.o;
  assert m == OnOff.ON;
  assert inv.o == OnOff.ON;
  assert m2 == inv.o;
}
