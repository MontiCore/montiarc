package sd2arc.correct;

import montiarc.types.OnOff;
import montiarc.timed.Inverter;
import montiarc.timed.Medium;

complete sequencediagram InverterMediumSD1 {
  inv:Inverter;
  med:Medium;

  -> inv.i : trigger OnOff.ON;
  inv.o -> med.i : OnOff.OFF;
  med.o -> : med.i;
}
