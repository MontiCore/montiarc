package sd2arc.incorrect;

import montiarc.types.OnOff;
import montiarc.sync.Inverter;

complete sequencediagram TickBlockOmitsSyncPort {
  inv1:Inverter;
  inv2:Inverter;

  Tick {
    -> inv1.i : trigger OnOff.ON;
    inv1.o -> inv2.i : OnOff.OFF; // inv2.o is not stated
  }

  Tick; // neither inv1.o nor inv2.o is stated
}
